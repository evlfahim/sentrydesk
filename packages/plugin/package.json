{
  "name": "sentrydesk-vscode",
  "displayName": "SentryDesk",
  "description": "Docker container monitoring dashboard for VS Code — live CPU/RAM, logs, restart, compose viewer, disk cleanup.",
  "version": "0.1.0",
  "publisher": "sentrydesk",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "sentrydesk.connect", "title": "SentryDesk: Connect to Docker", "icon": "$(plug)" },
      { "command": "sentrydesk.disconnect", "title": "SentryDesk: Disconnect from Docker", "icon": "$(debug-disconnect)" },
      { "command": "sentrydesk.refresh", "title": "SentryDesk: Refresh Containers", "icon": "$(refresh)" },
      { "command": "sentrydesk.restart", "title": "SentryDesk: Restart Container", "icon": "$(debug-restart)" },
      { "command": "sentrydesk.stop", "title": "SentryDesk: Stop Container", "icon": "$(debug-stop)" },
      { "command": "sentrydesk.start", "title": "SentryDesk: Start Container", "icon": "$(debug-start)" },
      { "command": "sentrydesk.remove", "title": "SentryDesk: Remove Container", "icon": "$(trash)" },
      { "command": "sentrydesk.viewLogs", "title": "SentryDesk: View Container Logs", "icon": "$(output)" },
      { "command": "sentrydesk.searchLogs", "title": "SentryDesk: Search Logs", "icon": "$(search)" },
      { "command": "sentrydesk.toggleFollow", "title": "SentryDesk: Toggle Log Follow Mode" },
      { "command": "sentrydesk.clearLogs", "title": "SentryDesk: Clear Logs" },
      { "command": "sentrydesk.viewMetrics", "title": "SentryDesk: View Container Metrics", "icon": "$(graph)" },
      { "command": "sentrydesk.startMetrics", "title": "SentryDesk: Start Metrics Collection" },
      { "command": "sentrydesk.stopMetrics", "title": "SentryDesk: Stop Metrics Collection" },
      { "command": "sentrydesk.viewCompose", "title": "SentryDesk: View Compose File", "icon": "$(file-code)" },
      { "command": "sentrydesk.parseCompose", "title": "SentryDesk: Parse Compose YAML" },
      { "command": "sentrydesk.viewCleanup", "title": "SentryDesk: View Disk Cleanup", "icon": "$(trash)" },
      { "command": "sentrydesk.analyzeCleanup", "title": "SentryDesk: Analyze Disk Usage" },
      { "command": "sentrydesk.executeCleanup", "title": "SentryDesk: Execute Cleanup Suggestion" },
      { "command": "sentrydesk.clearCleanup", "title": "SentryDesk: Clear Cleanup Suggestions" },
      { "command": "sentrydesk.openDashboard", "title": "SentryDesk: Open Dashboard", "icon": "$(dashboard)" }
    ],
    "configuration": {
      "title": "SentryDesk",
      "properties": {
        "sentrydesk.ipc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Expose @sentrydesk/core over a local IPC socket so external tools can query the same Docker state."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sentrydesk",
          "title": "SentryDesk",
          "icon": "$(server-process)"
        }
      ]
    },
    "views": {
      "sentrydesk": [
        {
          "id": "sentrydesk.containers",
          "name": "Containers"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sentrydesk.containers",
        "contents": "No containers connected.\n[Connect to Docker](command:sentrydesk.connect)\n\nConnect to the Docker daemon to start monitoring containers."
      }
    ],
    "menus": {
      "view/title": [
        { "command": "sentrydesk.refresh", "when": "view == sentrydesk.containers", "group": "navigation" },
        { "command": "sentrydesk.openDashboard", "when": "view == sentrydesk.containers", "group": "navigation" },
        { "command": "sentrydesk.viewCleanup", "when": "view == sentrydesk.containers", "group": "navigation" },
        { "command": "sentrydesk.viewCompose", "when": "view == sentrydesk.containers", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "sentrydesk.viewLogs", "group": "inline@1", "when": "view == sentrydesk.containers && viewItem =~ /^container/" },
        { "command": "sentrydesk.viewMetrics", "group": "inline@2", "when": "view == sentrydesk.containers && viewItem =~ /^container/" },
        { "command": "sentrydesk.restart", "group": "inline@3", "when": "view == sentrydesk.containers && viewItem =~ /^container/" },
        { "command": "sentrydesk.stop", "group": "inline@4", "when": "view == sentrydesk.containers && viewItem == container-running" },
        { "command": "sentrydesk.start", "group": "inline@4", "when": "view == sentrydesk.containers && viewItem =~ /^container-(exited|created|dead)$/" },
        { "command": "sentrydesk.remove", "group": "lifecycle", "when": "view == sentrydesk.containers && viewItem =~ /^container/" }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentrydesk/core": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
