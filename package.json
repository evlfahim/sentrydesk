{
  "name": "sentrydesk",
  "version": "0.1.0",
  "description": "A lightweight, offline-first desktop dashboard for real-time Docker container monitoring",
  "main": "dist-electron/main.js",
  "author": "SentryDesk",
  "license": "MIT",
  "homepage": "https://github.com/sentrydesk/sentrydesk",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:vite": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm -C packages/core run build && tsc && vite build && tsc -p tsconfig.electron.json && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc && vite build && electron-builder",
    "test": "vitest run",
    "test:client": "vitest run src/__tests__/docker-client.test.ts",
    "test:metrics": "vitest run src/__tests__/metrics.test.ts",
    "test:logs": "vitest run src/__tests__/logs.test.ts",
    "test:restart": "vitest run src/__tests__/restart.test.ts",
    "test:compose": "vitest run src/__tests__/compose.test.ts",
    "test:disk": "vitest run src/__tests__/disk.test.ts",
    "test:core": "vitest run src/__tests__/core.test.ts",
    "test:ipc": "vitest run src/__tests__/ipc.test.ts",
    "test:plugin": "vitest run --root packages/plugin",
    "build:plugin": "npm -C packages/core run build && npm -C packages/plugin run build",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentrydesk/core": "*",
    "dockerode": "^4.0.2",
    "js-yaml": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.30",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.145.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.sentrydesk.app",
    "productName": "SentryDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "packages/core/dist/**/*"
    ],
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "sentrydesk@users.noreply.github.com"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
